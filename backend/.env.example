APP_NAME=WavyGo Vendor API
APP_ENV=development
MONGODB_URI=
MONGODB_DATABASE=wavygo_vendor
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_MINUTES=30

# Cloudinary — used by app/services/cloudinary_service.py
# Never commit actual values. Copy this file to .env and fill in.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
