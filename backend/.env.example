APP_NAME=WavyGo Vendor API
APP_ENV=development
MONGODB_URI=
MONGODB_DATABASE=wavygo_vendor
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-32-byte-minimum-secret
JWT_ISSUER=wavygo-api
JWT_AUDIENCE=wavygo-vendor
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# Cloudinary — used by app/services/cloudinary_service.py
# Never commit actual values. Copy this file to .env and fill in.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
